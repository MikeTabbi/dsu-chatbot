# Copy to .env and fill in. Never commit .env.

# Claude client: fake (canned answers, no key or network) | anthropic | azure (not built yet, #19)
CLAUDE_CLIENT=fake
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_OUTPUT_TOKENS=4096
CLAUDE_TIMEOUT_SECONDS=30

# Search index (Azure AI Search)
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_INDEX_NAME=dsu-content

# Retriever: local (keyword search over CHUNKS_DIR, no cloud) | azure (not built yet)
RETRIEVER=local
CHUNKS_DIR=data/chunks
RETRIEVER_MIN_SCORE=0.1
SYNONYMS_FILE=api/app/synonyms.yaml
# /chat: chunks retrieved per question, and the longest question accepted
CHAT_TOP_K=5
CHAT_MAX_QUESTION_CHARS=1000

# App
# Sites whose pages may call the API (the widget), comma-separated, exact. Never "*".
# Production: DSU's site, e.g. https://www.desu.edu
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# Exchange log: every /chat exchange and its thumbs up/down, PII redacted
# sqlite (a local file under data/, gitignored) | none (keep nothing)
EXCHANGE_LOG=sqlite
EXCHANGE_LOG_PATH=data/exchanges/exchanges.sqlite
# Days to keep exchanges; python -m api.app.exchange_log purge deletes older ones
EXCHANGE_RETENTION_DAYS=90
FEEDBACK_MAX_COMMENT_CHARS=500

# Rate limits and abuse protection (README: Rate limits and abuse protection). 0 turns a limit off.
RATE_LIMITER=memory
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_DAY=100
RATE_LIMIT_FEEDBACK_PER_MINUTE=30
# Claude calls per UTC day across all clients; past it /chat says the assistant is busy
CLAUDE_DAILY_CALL_BUDGET=2000
# true only behind a proxy that sets X-Forwarded-For (Azure App Service); otherwise it can be spoofed
TRUST_PROXY=false
MAX_REQUEST_BYTES=16384
