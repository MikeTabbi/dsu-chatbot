# Copy to .env and fill in. Never commit .env.

# Claude client: fake (canned answers, no key or network) | anthropic | azure (not built yet, #19)
CLAUDE_CLIENT=fake
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_OUTPUT_TOKENS=4096
CLAUDE_TIMEOUT_SECONDS=30

# Search index (Azure AI Search)
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_INDEX_NAME=dsu-content

# Retriever: local (keyword search over CHUNKS_DIR, no cloud) | azure (not built yet)
RETRIEVER=local
CHUNKS_DIR=data/chunks
RETRIEVER_MIN_SCORE=0.1
# /chat: chunks retrieved per question, and the longest question accepted
CHAT_TOP_K=5
CHAT_MAX_QUESTION_CHARS=1000

# App
ALLOWED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
