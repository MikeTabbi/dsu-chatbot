# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Search index (Azure AI Search)
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_INDEX_NAME=dsu-content

# Retriever: local (keyword search over CHUNKS_DIR, no cloud) | azure (not built yet)
RETRIEVER=local
CHUNKS_DIR=data/chunks
RETRIEVER_MIN_SCORE=0.1

# App
ALLOWED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
